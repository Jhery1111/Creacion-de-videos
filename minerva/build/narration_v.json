{
 "0": [
  {
   "file": "v00_u0.mp3",
   "dur": 4.56,
   "segments": [
    {
     "text": "MINERVA, el Sistema de Evaluación Psicológica de la Policía Boliviana.",
     "start": 0.0,
     "end": 3.787
    }
   ]
  },
  {
   "file": "v00_u1.mp3",
   "dur": 3.984,
   "segments": [
    {
     "text": "Te mostramos cómo ingresar y rendir tu examen, paso a paso.",
     "start": 0.0,
     "end": 3.219
    }
   ]
  }
 ],
 "1": [
  {
   "file": "v01_u0.mp3",
   "dur": 4.392,
   "segments": [
    {
     "text": "Paso uno: en la pantalla de inicio, tocá el portal Policía.",
     "start": 0.0,
     "end": 3.623
    }
   ]
  }
 ],
 "2": [
  {
   "file": "v02_u0.mp3",
   "dur": 4.656,
   "segments": [
    {
     "text": "Escribí tu número de carnet y tu escalafón,",
     "start": 0.0,
     "end": 2.05
    },
    {
     "text": "tal como figuran en tu credencial,",
     "start": 2.323,
     "end": 3.885
    }
   ]
  },
  {
   "file": "v02_u1.mp3",
   "dur": 2.256,
   "segments": [
    {
     "text": "y tocá Ingresar al Sistema.",
     "start": 0.0,
     "end": 1.481
    }
   ]
  }
 ],
 "3": [
  {
   "file": "v03_u0.mp3",
   "dur": 3.888,
   "segments": [
    {
     "text": "En la sala, tu sesión aparece en la pestaña En Inscripción.",
     "start": 0.0,
     "end": 3.12
    }
   ]
  },
  {
   "file": "v03_u1.mp3",
   "dur": 2.376,
   "segments": [
    {
     "text": "Tocá Descargar Consentimiento.",
     "start": 0.0,
     "end": 1.613
    }
   ]
  }
 ],
 "4": [
  {
   "file": "v04_u0.mp3",
   "dur": 6.312,
   "segments": [
    {
     "text": "Verificá tus datos.",
     "start": 0.0,
     "end": 1.307
    },
    {
     "text": "Si tu grado o tu departamento no son correctos, corregilos aquí.",
     "start": 2.065,
     "end": 5.529
    }
   ]
  },
  {
   "file": "v04_u1.mp3",
   "dur": 4.104,
   "segments": [
    {
     "text": "Luego confirmá con: Mis datos son correctos, Descargar.",
     "start": 0.0,
     "end": 3.328
    }
   ]
  }
 ],
 "5": [
  {
   "file": "v05_u0.mp3",
   "dur": 5.184,
   "segments": [
    {
     "text": "Se descarga tu Consentimiento Informado oficial,",
     "start": 0.0,
     "end": 2.301
    },
    {
     "text": "con tus datos y el espacio para tu firma.",
     "start": 2.552,
     "end": 4.399
    }
   ]
  }
 ],
 "6": [
  {
   "file": "v06_u0.mp3",
   "dur": 4.128,
   "segments": [
    {
     "text": "Cuando el examen se habilita,",
     "start": 0.0,
     "end": 1.241
    },
    {
     "text": "la sesión pasa a Disponibles ahora.",
     "start": 1.514,
     "end": 3.361
    }
   ]
  },
  {
   "file": "v06_u1.mp3",
   "dur": 2.112,
   "segments": [
    {
     "text": "Tocá Entrar al Examen.",
     "start": 0.0,
     "end": 1.328
    }
   ]
  }
 ],
 "7": [
  {
   "file": "v07_u0.mp3",
   "dur": 4.944,
   "segments": [
    {
     "text": "En el lobby revisá la duración, tus intentos",
     "start": 0.0,
     "end": 2.41
    },
    {
     "text": "y leé los términos y condiciones.",
     "start": 2.421,
     "end": 4.18
    }
   ]
  },
  {
   "file": "v07_u1.mp3",
   "dur": 4.56,
   "segments": [
    {
     "text": "Tocá la casilla He leído y acepto:",
     "start": 0.0,
     "end": 1.886
    },
    {
     "text": "así se habilita Iniciar Examen.",
     "start": 2.137,
     "end": 3.798
    }
   ]
  }
 ],
 "8": [
  {
   "file": "v08_u0.mp3",
   "dur": 5.448,
   "segments": [
    {
     "text": "Respondé una pregunta a la vez.",
     "start": 0.0,
     "end": 1.809
    },
    {
     "text": "Arriba ves el tiempo restante y tu avance.",
     "start": 2.568,
     "end": 4.666
    }
   ]
  },
  {
   "file": "v08_u1.mp3",
   "dur": 2.976,
   "segments": [
    {
     "text": "Elegí tu respuesta y avanzá con la flecha.",
     "start": 0.0,
     "end": 2.213
    }
   ]
  }
 ],
 "9": [
  {
   "file": "v09_u0.mp3",
   "dur": 4.176,
   "segments": [
    {
     "text": "Al tocar Enviar, si te faltan preguntas, el sistema te avisa.",
     "start": 0.0,
     "end": 3.404
    }
   ]
  },
  {
   "file": "v09_u1.mp3",
   "dur": 3.696,
   "segments": [
    {
     "text": "Podés responder las que faltan",
     "start": 0.0,
     "end": 1.405
    },
    {
     "text": "o confirmar con Enviar Examen.",
     "start": 1.416,
     "end": 2.924
    }
   ]
  }
 ],
 "10": [
  {
   "file": "v10_u0.mp3",
   "dur": 2.616,
   "segments": [
    {
     "text": "Tu examen se envía de forma segura,",
     "start": 0.0,
     "end": 1.831
    }
   ]
  },
  {
   "file": "v10_u1.mp3",
   "dur": 4.464,
   "segments": [
    {
     "text": "y verás el resumen: intento, preguntas, duración y fecha.",
     "start": 0.0,
     "end": 3.689
    }
   ]
  }
 ],
 "11": [
  {
   "file": "v11_u0.mp3",
   "dur": 6.168,
   "segments": [
    {
     "text": "¡Listo! Tu examen quedó registrado.",
     "start": 0.0,
     "end": 2.786
    },
    {
     "text": "Consultá tu resultado en el sistema.",
     "start": 3.54,
     "end": 5.409
    }
   ]
  }
 ]
}